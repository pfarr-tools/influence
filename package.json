{
  "name": "influence",
  "version": "0.1.1",
  "private": false,
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/pfarr-tools/influence.git"
  },
  "homepage": "https://github.com/pfarr-tools/influence#readme",
  "bugs": {
    "url": "https://github.com/pfarr-tools/influence/issues"
  },
  "type": "module",
  "bin": {
    "influence": "bin/influence.js"
  },
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "prayer:generate": "influence prayer generate",
    "review:frontend:build": "vite build --config src/services/review/frontend/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "release": "standard-version",
    "release:first": "standard-version --first-release"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "bootstrap": "^5.3.8",
    "commander": "^14.0.0",
    "dotenv": "^17.2.1",
    "handlebars": "^4.7.9",
    "jsdom": "^30.0.1",
    "marked": "^18.0.9",
    "openai": "^5.12.2",
    "playwright": "^1.55.0",
    "sass": "^1.102.0",
    "sharp": "^0.33.5",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "eslint": "^9.33.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "standard-version": "^9.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
