OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
FLUX_API_KEY=
FLUX_API_BASE_URL=https://api.bfl.ai
FLUX_API_GENERATE_PATH=/v1
# Current official BFL model/endpoint slugs as of 2026-08-05:
# flux-2-max
# flux-2-pro-preview
# flux-2-pro
# flux-2-flex
# flux-2-klein-4b
# flux-2-klein-9b-preview
# flux-2-klein-9b
# flux-kontext-max
# flux-kontext-pro
# flux-pro-1.1-ultra
# flux-pro-1.1
# flux-pro
# flux-dev
#
# Note: the official BFL API selects models via endpoint path (for example
# /v1/flux-2-pro-preview) and returns async jobs plus polling URLs. This project’s
# current Flux client supports the official BFL async flow when used with
# FLUX_API_BASE_URL=https://api.bfl.ai and FLUX_API_GENERATE_PATH=/v1.
FLUX_MODEL=flux-2-pro-preview
CONTENT_CALENDAR_PATH=./data/redaktionskalender-2026-2027.json
OUTPUT_DIR=./output
TZ=Europe/Berlin
PUBLIC_BASE_URL=https://example.org
PUBLICATION_TIMEZONE=Europe/Berlin
PUBLICATION_PLATFORMS=facebook,instagram,mastodon
PUBLICATION_DEFAULT_TIME_FACEBOOK=12:00
PUBLICATION_DEFAULT_TIME_INSTAGRAM=08:00
PUBLICATION_DEFAULT_TIME_MASTODON=08:15
PUBLICATION_DEFAULT_TIME_THREADS=08:45
PUBLICATION_DEFAULT_TIME_BLUESKY=08:30
PUBLICATION_DEFAULT_TIME_LINKEDIN=09:30
# Generic HTTP publishing adapters. Set both values for a platform to enable it.
# Mastodon is native and uses MASTODON_SERVER_URL below.
INSTAGRAM_API_URL=
INSTAGRAM_ACCESS_TOKEN=
MASTODON_SERVER_URL=
MASTODON_ACCESS_TOKEN=
MASTODON_CLIENT_NAME=Influence
MASTODON_CLIENT_ID=
MASTODON_CLIENT_SECRET=
MASTODON_VISIBILITY=public
MASTODON_LANGUAGE=de
THREADS_API_URL=
THREADS_ACCESS_TOKEN=
BLUESKY_API_URL=
BLUESKY_ACCESS_TOKEN=
LINKEDIN_API_URL=
LINKEDIN_ACCESS_TOKEN=
