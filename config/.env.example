# Influence configuration template
# Copy this file to config/.env and replace placeholders with your values.
# Keep config/.env private. Never commit API keys or access tokens.

# Branding used in generated images, OAuth client registration, and public links.
BRAND_NAME=Influence
BRAND_WEBSITE=https://example.org
SOURCE_MARK=example.org
IMAGE_CREDITS=Your name or image source

# Content and local files.
CONTENT_CALENDAR_PATH=./content/content-plan.json
OUTPUT_DIR=./content
TZ=Europe/Berlin
PUBLIC_BASE_URL=https://example.org
FFMPEG_BIN=ffmpeg
REEL_SUBTITLE_FONT_NAME=Atkinson Hyperlegible Next
REEL_SUBTITLE_FONTS_DIR=
IMAGE_CREDITS_FONT_PATH=

# Publication defaults. Only configure platforms you have permission to use.
PUBLICATION_TIMEZONE=Europe/Berlin
PUBLICATION_PLATFORMS=facebook,instagram,mastodon
PUBLICATION_DEFAULT_TIME=07:00
PUBLICATION_DEFAULT_TIME_FACEBOOK=12:00
PUBLICATION_DEFAULT_TIME_INSTAGRAM=08:00
PUBLICATION_DEFAULT_TIME_MASTODON=08:15
PUBLICATION_DEFAULT_TIME_THREADS=08:45
PUBLICATION_DEFAULT_TIME_BLUESKY=08:30
PUBLICATION_DEFAULT_TIME_LINKEDIN=09:30

# OpenAI content generation and review chat.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Black Forest Labs / Flux image generation.
FLUX_API_KEY=
FLUX_API_BASE_URL=https://api.bfl.ai
FLUX_API_GENERATE_PATH=/v1
FLUX_MODEL=flux-2-pro-preview

# Optional publication webhook, called after a successful publish run.
WEBHOOK_URL=
WEBHOOK_SECRET=

# Mastodon native adapter. OAuth can provision the client ID and secret.
MASTODON_SERVER_URL=https://mastodon.example.org
MASTODON_ACCESS_TOKEN=
MASTODON_CLIENT_NAME=Influence
MASTODON_CLIENT_ID=
MASTODON_CLIENT_SECRET=
MASTODON_VISIBILITY=public
MASTODON_LANGUAGE=de

# Instagram native adapter.
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_GRAPH_API_URL=https://graph.instagram.com
INSTAGRAM_GRAPH_API_VERSION=v23.0

# Threads native adapter.
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
THREADS_GRAPH_API_URL=https://graph.threads.net
THREADS_GRAPH_API_VERSION=v1.0

# Facebook Page native adapter.
FACEBOOK_PAGE_ID=
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_API_URL=https://graph.facebook.com
FACEBOOK_GRAPH_API_VERSION=v23.0

# Bluesky native adapter.
BLUESKY_SERVICE_URL=https://bsky.social
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=

# LinkedIn native REST adapter.
LINKEDIN_AUTHOR_URN=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_API_URL=https://api.linkedin.com
LINKEDIN_API_VERSION=202606
